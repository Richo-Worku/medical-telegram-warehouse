  create view "medical_warehouse"."raw"."fct_messages__dbt_tmp"
    
    
  as (
    with messages as (

    select *
    from "medical_warehouse"."raw"."stg_telegram_messages"

),

channels as (

    select *
    from "medical_warehouse"."raw"."dim_channels"

),

